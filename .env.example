# Optional: copy to .env. The site works with both values blank.
# Keep credentials in ignored local env files, never in this template.

# Public contact-form POST URL. Blank opens the visitor's email app.
# NEXT_PUBLIC_ values are visible in the browser; never put secrets here.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Public origin for metadata, robots.txt, and sitemap.xml.
# Blank defaults to https://tangdarren.com.
SITE_URL=
